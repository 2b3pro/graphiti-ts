{
  "name": "graphiti-ts",
  "private": true,
  "workspaces": ["packages/*"],
  "scripts": {
    "build": "bun run --filter '*' build",
    "check:no-pai-leaks": "bash scripts/check-no-pai-leaks.sh",
    "verify": "bun run check:no-pai-leaks && bun run build && bun run typecheck && bun run test",
    "release:cut": "bash scripts/release-cut.sh",
    "test": "bun run --filter '*' test",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "bun run --filter '*' typecheck"
  },
  "devDependencies": {
    "@biomejs/biome": "latest",
    "@types/bun": "latest",
    "typescript": "^5.8.0"
  }
}
